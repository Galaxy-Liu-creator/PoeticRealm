# 文本统一 LF
* text=auto eol=lf

# 制作端大文件走 Git LFS（见 docs/设计文档.md 19.3）
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
art/textures-src/** filter=lfs diff=lfs merge=lfs -text
art/audio-src/**    filter=lfs diff=lfs merge=lfs -text
art/textures-src/.gitkeep -filter -diff -merge text
art/audio-src/.gitkeep    -filter -diff -merge text

# 运行端二进制
*.glb   binary
*.png   binary
*.webp  binary
*.ktx2  binary
*.mp3   binary
*.m4a   binary
*.woff2 binary
