# 依赖与构建产物
node_modules/
dist/
dist-offline/
*.tsbuildinfo
.vite/
.cache/

# 测试运行生成的报告与截图（docs/ 中的验收资料仍入库）
/output/
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
*.lcov

# 环境变量与密钥
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# tools/ 生成的输出（截图对比、录屏帧、离线包）
tools/out/
tools/.cache/
*.zip

# Blender 自动备份与崩溃恢复文件
*.blend1
*.blend2
*.blend[0-9]*
*.blend@
quit.blend

# Python 缓存（art/scripts）
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 临时文件、冲突残留与进程转储
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.dmp
*.crash

# 编辑器与系统文件
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Claude Code 本地会话设置（个人配置，不入库）
.claude/settings.local.json
