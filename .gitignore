# 依赖与构建产物
node_modules/
dist/
dist-offline/
*.tsbuildinfo
.vite/
.cache/

# 测试运行生成的报告与截图（docs/ 中的验收资料仍入库）
/output/
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright-mcp/
*.lcov

# 环境变量与密钥
.env
.env.*
!.env.example
!.env.docker.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# tools/ 生成的输出（截图对比、录屏帧、离线包）
tools/out/
tools/.cache/
/frontend/tools/out/
/frontend/tools/.cache/
*.zip

# Spring Boot 构建与本机数据、私密配置
/backend/target/
/runtime/
**/application-local.yml
**/application-local.yaml
**/application-local.properties

# 建模源文件和导出模型仅在 Windows / Ubuntu 本机保留，不提交 GitHub
*.blend
*.glb
*.gltf
*.fbx
*.obj

# Blender 自动备份与崩溃恢复文件
*.blend1
*.blend2
*.blend[0-9]*
*.blend@
quit.blend

# Python 缓存（art/scripts）
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 临时文件、冲突残留与进程转储
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.dmp
*.crash

# 编辑器与系统文件
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Claude Code 本地会话设置（个人配置，不入库）
.claude/settings.local.json

# Ubuntu 迁移只保留设计与阶段记录的文字文件；历史媒体留在 Windows 原盘
/docs/design/**
!/docs/design/**/
!/docs/design/**/*.md
!/docs/design/**/*.txt
!/docs/design/**/*.json
!/docs/design/**/*.yaml
!/docs/design/**/*.yml
!/docs/design/**/*.csv
/docs/plans/**
!/docs/plans/**/
!/docs/plans/**/*.md
!/docs/plans/**/*.txt
!/docs/plans/**/*.json
!/docs/plans/**/*.yaml
!/docs/plans/**/*.yml
!/docs/plans/**/*.csv

# 本机应用运行目录与凭据目录
/.agents/
/.codex/
/.aws/

# 部署时的本机容器原始快照；验收摘要 verification.json 继续入库
/docs/design/**/evidence/deployment/before.json
/docs/design/**/evidence/deployment/after.json
